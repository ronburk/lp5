<template>
    <heading>Expanding code for display</heading>
    <keywords><li>view</li><li>output</li><li>expansion</li><li>indentation</li></keywords>
    <section data-lp5-kind="explanation">
        <p>Output is a view of the model's <a href="#33.lp5">bundle graph</a>. Expansion retains article ownership, distinct occurrence paths, and reference offsets into each fragment's authored text. These boundaries matter when one definition is expanded several times or inside another definition.</p>
        <p>Expansion, formatting, and DOM rendering are separate stages. The formatter removes each fragment's common leading spaces, then indents continuation lines to match the reference site. Reference indentation is measured after removing the fragment's common prefix. Literal code is already decoded by the <a href="https://developer.mozilla.org/en-US/docs/Web/API/DOMParser">XML parser</a>; decoding HTML entities again would corrupt it.</p>
        <p>Undefined references remain visible as diagnostic placeholders, allowing unfinished projects to be read. They are presentation diagnostics, not valid generated code. Other XML wrapper elements retain their markup while references within them expand. This display does not write output files.</p>
    </section>
    <section data-lp5-kind="code">
        <name>View output expansion</name>
        <code><![CDATA[// Trim a code name and collapse its internal whitespace to single spaces.
function normalizedCodeName(name) {
    return name.replace(/^[ \t\r\n]+|[ \t\r\n]+$/g, "").replace(/[ \t\r\n]+/g, " ");
}

// Split an article's code into text and reference parts, retaining source positions for navigation.
function codeParts(article) {
    // Locate the code section among the article's direct children.
    const section = Array.from(article.document.documentElement.children).find(
        // Select only the section marked as code.
        element =>
        element.tagName === "section" && element.getAttribute("data-lp5-kind") === "code");
    if (!section) return null;
    const code = section.querySelector("code");
    const parts = [];
    let offset = 0;
    const serializer = new XMLSerializer();
    // Record a text fragment and advance the virtual source position when it is represented in sourceText.
    function text(value, emit = true, showSource = true) {
        parts.push({ kind: "text", text: value, sourceOffset: offset, emit, showSource });
        offset += showSource ? value.length : 0;
    }
    // Walk code XML, preserving wrapper markup and representing lp5- elements as expandable references.
    function visit(node, top = false) {
        if (node.nodeType === Node.CDATA_SECTION_NODE || node.nodeType === Node.TEXT_NODE) {
            const whitespace = /^[ \t\r\n]*$/.test(node.data);
            // Ignore top-level formatting whitespace in source positions while retaining it for display formatting.
            text(node.data, !(top && code.children.length && whitespace),
                !top || node.nodeType === Node.CDATA_SECTION_NODE);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
            const serialized = serializer.serializeToString(node);
            if (node.tagName === "lp5-") {
                parts.push({ kind: "reference", name: normalizedCodeName(node.getAttribute("ref")),
                    sourceOffset: offset, sourceText: serialized });
                offset += serialized.length;
            } else {
                const opening = serializer.serializeToString(node.cloneNode(false)).replace(/\/>$/, ">");
                text(opening);
                for (const child of node.childNodes) visit(child);
                if (!["area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"].includes(node.tagName))
                    text(`</${node.tagName}>`);
            }
        }
    }
    for (const node of code.childNodes) visit(node, true);
    // Reconstruct the code string used for common indentation and reference-site positions.
    const sourceText = parts.map(part => part.kind === "reference" ? part.sourceText : part.showSource ? part.text : "").join("");
    const baseIndent = minimumIndent(sourceText);
    // Store each reference's indentation relative to this fragment's common leading indentation.
    for (const part of parts) {
        if (part.kind === "reference")
            part.indent = referenceIndent(sourceText, part.sourceOffset, baseIndent);
    }
    return { name: normalizedCodeName(section.querySelector("name").textContent), parts, sourceText, baseIndent };
}

// Return the smallest leading-space count among nonblank lines.
function minimumIndent(text) {
    const lines = text.split(/\r?\n/);
    // Ignore blank lines because they have no indentation to preserve.
    const nonblankLines = lines.filter(
        line => /\S/.test(line));
    // Measure the shared prefix using spaces, which are the indentation unit removed below.
    const indents = nonblankLines.map(
        line => line.match(/^ */)[0].length);
    return indents.length ? Math.min(...indents) : 0;
}

// Measure indentation at a reference after removing the fragment's common indentation.
function referenceIndent(sourceText, offset, baseIndent) {
    const lineStart = sourceText.lastIndexOf("\n", offset - 1) + 1;
    const prefix = sourceText.slice(lineStart, offset);
    return /^[ ]*$/.test(prefix) ? Math.max(0, prefix.length - baseIndent) : 0;
}

// Create a stable key for one reference site within an article.
function referenceKey(filename, offset) {
    return JSON.stringify([filename, offset]);
}

// Recursively expand a bundle while retaining article ownership and reference-site identity.
function expandOutput(name, path = [name], active = new Set()) {
    if (active.has(name)) throw new Error(`Code bundle cycle while displaying ${name}`);
    active.add(name);
    const articles = model.getBundle(name);
    // Give every definition an occurrence path so repeated expansions remain distinguishable.
    const children = articles.map((article, index) => {
        const definition = codeParts(article);
        const key = [...path, index];
        return { kind: "article", filename: article.filename, name, key: JSON.stringify(key),
            sourceText: definition.sourceText, baseIndent: definition.baseIndent,
            // Expand each reference in place, recording its source site for later highlighting.
            children: definition.parts.map((part, partIndex) => {
                if (part.kind === "text") return part;
                return { kind: "reference", name: part.name, indent: part.indent,
                    sourceOffset: part.sourceOffset, sourceText: part.sourceText,
                    sourceKey: referenceKey(article.filename, part.sourceOffset),
                    children: expandOutput(part.name, [...key, partIndex], active) };
            }) };
    });
    active.delete(name);
    return articles.length ? children : [{ kind: "missing", name }];
}

// Format expanded nodes into display tokens, reconstructing indentation without changing code ownership.
function* formatOutput(nodes, outermost = true) {
    let atLineStart = true;
    // Adjust only the start of each line, preserving its authored text and newline.
    function formatText(value, indent, baseIndent) {
        let result = "";
        for (const line of value.match(/[^\n]*\n|[^\n]+$/g) || []) {
            const hasNewline = line.endsWith("\n");
            let body = hasNewline ? line.slice(0, -1) : line;
            if (atLineStart) {
                if (baseIndent && body.startsWith(" ".repeat(baseIndent)))
                    body = body.slice(baseIndent);
                if (body.length) {
                    result += " ".repeat(indent);
                    atLineStart = false;
                }
            }
            result += body;
            if (hasNewline) {
                result += "\n";
                atLineStart = true;
            }
        }
        return result;
    }
    // Walk expanded nodes in order while carrying the indentation context through references.
    function* walk(items, indent = 0, baseIndent = 0) {
        for (const node of items) {
            if (node.kind === "text" || node.kind === "missing") {
                const text = formatText(node.kind === "missing" ? `[[Undefined bundle: ${node.name}]]` : node.text,
                    indent, baseIndent);
                if (text) yield { ...node, text };
            } else if (node.kind === "article") {
                // Use the first nonblank source line to keep folded markers aligned with the code section.
                const sourceLine = node.sourceText.split(/\r?\n/).find(
                    // Find the first line that contains code text.
                    line => /\S/.test(line)) || "";
                const sourceIndent = sourceLine.match(/^[ \t]*/)[0];
                const outputIndent = atLineStart ?
                    " ".repeat(indent) + sourceIndent.slice(node.baseIndent) : sourceIndent;
                yield { kind: "open", node, indent: outputIndent };
                yield* walk(node.children, indent, node.baseIndent);
                yield { kind: "close", node };
            } else {
                yield { kind: "open", node };
                yield* walk(node.children, indent + node.indent, baseIndent);
                yield { kind: "close", node };
            }
        }
    }
    yield* walk(nodes);
    // The harness HTML serializer terminates each output with a newline.
    if (outermost) {
        const text = formatText("\n", 0, 0);
        if (text) yield { kind: "text", text };
    }
}
]]></code>
    </section>
</template>
