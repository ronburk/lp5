<template>
    <children>
        <li id="47.lp5"/>
        <li id="42.lp5"/>
        <li id="41.lp5"/>
        <li id="40.lp5"/>
        <li id="39.lp5"/>
    </children>
    <heading>View</heading>
    <keywords>
        <li>view</li>
        <li>modal dialog</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>The view subscribes to model load notifications during startup, so any <a href="#32.lp5">successful load or reload</a> refreshes all three panes without requiring its caller to know how articles are displayed. Rendering is private to the view; the operation still owns dialog cleanup and command-state changes.</p>
        <p>Pane dragging belongs to the view because it changes presentation only. <a href="https://developer.mozilla.org/en-US/docs/Web/API/Pointer_events#pointer_capture">Pointer capture</a> keeps a drag active outside the narrow divider; release, cancellation, or lost capture restores text selection. Only the adjacent panes exchange width, with a 100-pixel minimum where space permits. Flex weights preserve their proportions when the window changes size. A colored rule at the top of a pane identifies the pane selected by pointer interaction or keyboard focus.</p>
        <p>Mounting a dialog and deciding which commands it accepts are separate responsibilities. The view owns its DOM lifetime; the operation owns the interaction's state and decides when to close it. <code>showModalDialog(dialogName, context?)</code> therefore returns immediately; the optional context is passed to the template initializer. The article editor uses it to supply the filename and XML draft. <code>closeModalDialog(dialogName)</code> ends that mount when the operation decides it is finished.</p>
        <p>A <a href="#23.lp5">dialog template</a> must provide a style immediately before its dialog, and its initialization script must return the mounted <a href="https://developer.mozilla.org/en-US/docs/Web/API/HTMLDialogElement"><code>HTMLDialogElement</code></a>. Shared modal styles are inserted before the dialog-specific styles so the latter can override them. The view tracks all three nodes as one mounted resource; closing removes the dialog and both style clones so repeated use leaves no styles behind.</p>
    </section>
    <section data-lp5-kind="code">
        <name>JavaScript units</name>
        <code><![CDATA[let view = (() => {
    const dialogs = new Map();
    function showModalDialog(dialogName, context) {
        const templates = document.getElementById("LP5-Dialog-Templates");
        if (!(templates instanceof HTMLTemplateElement))
            throw new Error("Missing LP5-Dialog-Templates template");

        const template = templates.content.querySelector(`#${dialogName}`);
        if (!(template instanceof HTMLTemplateElement))
            throw new Error(`Missing dialog template: ${dialogName}`);

        const sharedStyle = templates.content.firstElementChild;
        if (!(sharedStyle instanceof HTMLStyleElement))
            throw new Error("Missing shared dialog styles");

        const dialog = util.mountTemplate(template, document.body, context);
        if (!(dialog instanceof HTMLDialogElement))
            throw new Error(`Dialog template script did not return a dialog: ${dialogName}`);

        const dialogStyle = dialog.previousElementSibling;
        if (!(dialogStyle instanceof HTMLStyleElement))
            throw new Error(`Dialog template has no dialog styles: ${dialogName}`);

        const mountedSharedStyle = sharedStyle.cloneNode(true);
        dialogStyle.before(mountedSharedStyle);
        dialog.showModal();
        dialogs.set(dialogName, { dialog, dialogStyle, mountedSharedStyle });
    }

    function showArticleEditor(filename) {
        const article = model.getArticle(filename);
        if (!article) throw new Error(`Unknown article: ${filename}`);
        const source = new XMLSerializer().serializeToString(article.document);
        showModalDialog("EditArticle", { filename, source });
    }

    function showArticleEditorError(message) {
        const dialog = document.getElementById("EditArticle-dialog");
        const error = document.getElementById("EditArticle-error");
        const save = dialog?.querySelector('[data-id="save"]');
        const cancel = dialog?.querySelector('[data-id="cancel"]');
        if (!dialog || !error || !save || !cancel)
            throw new Error("Edit Article dialog is not mounted");
        error.textContent = message;
        error.hidden = false;
        for (const control of dialog.querySelectorAll("input, textarea"))
            control.disabled = false;
        cancel.disabled = false;
        save.disabled = false;
        save.focus();
    }

    function closeModalDialog(dialogName) {
        const mounted = dialogs.get(dialogName);
        if (!mounted)
            throw new Error(`Dialog is not mounted: ${dialogName}`);
        mounted.dialog.close();
        mounted.dialog.remove();
        mounted.dialogStyle.remove();
        mounted.mountedSharedStyle.remove();
        dialogs.delete(dialogName);
    }

    ]]><lp5- ref="View output expansion"/><lp5- ref="View output display"/><lp5- ref="View table of contents"/><lp5- ref="View article rendering"/><lp5- ref="View split panes"/><![CDATA[

    // Search the currently selected pane and keep the browser's document-wide find closed.
    function initializePaneFind() {
        const panes = ["LP5-Toc", "LP5-Source", "LP5-Output"]
            .map(id => document.getElementById(id));
        const bar = document.getElementById("LP5-FindBar");
        const scope = document.getElementById("LP5-FindScope");
        const input = document.getElementById("LP5-FindInput");
        const count = document.getElementById("LP5-FindCount");
        let matches = [];
        let current = -1;
        let searchPane = panes.find(pane => pane.classList.contains("LP5-PaneSelected")) || panes[1];
        let searchView = activePaneView(searchPane.id);

        function paneName(pane) {
            return pane.id === "LP5-Toc" ? "Table of Contents" :
                pane.id === "LP5-Source" ? "Source" : "Output";
        }

        function positionAt(index) {
            if (!matches.length) return;
            current = (index + matches.length) % matches.length;
            const range = matches[current];
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            range.startContainer.parentElement?.scrollIntoView({block: "nearest", inline: "nearest"});
            count.textContent = `${current + 1}/${matches.length}`;
        }

        function locate(nodes, offset) {
            return nodes.find(item => item.start <= offset && offset < item.end);
        }

        function update() {
            searchPane = panes.find(pane => pane.classList.contains("LP5-PaneSelected")) || panes[1];
            searchView = activePaneView(searchPane.id);
            scope.textContent = `Find in ${paneName(searchPane)}`;
            matches = [];
            current = -1;
            const query = input.value.toLowerCase();
            if (query) {
                const nodes = [];
                const walker = document.createTreeWalker(searchView, NodeFilter.SHOW_TEXT);
                let node, text = "";
                while ((node = walker.nextNode())) {
                    if (!node.data) continue;
                    const parent = node.parentElement;
                    if (parent.closest("script, style, [hidden], [aria-hidden='true']")) continue;
                    const visible = document.createRange();
                    visible.selectNodeContents(node);
                    if (!visible.getClientRects().length) continue;
                    const start = text.length;
                    text += node.data;
                    nodes.push({node, start, end: text.length});
                }
                const folded = text.toLowerCase();
                for (let offset = folded.indexOf(query); offset >= 0; offset = folded.indexOf(query, offset + 1)) {
                    const first = locate(nodes, offset);
                    const last = locate(nodes, offset + query.length - 1);
                    if (!first || !last) continue;
                    const range = document.createRange();
                    range.setStart(first.node, offset - first.start);
                    range.setEnd(last.node, offset + query.length - last.start);
                    matches.push(range);
                }
            }
            count.textContent = matches.length ? `1/${matches.length}` : "0/0";
            if (matches.length) positionAt(0);
            else window.getSelection().removeAllRanges();
        }

        function close() {
            bar.hidden = true;
            searchView?.focus({preventScroll: true});
        }

        function open() {
            searchPane = panes.find(pane => pane.classList.contains("LP5-PaneSelected")) || panes[1];
            searchView = activePaneView(searchPane.id);
            scope.textContent = `Find in ${paneName(searchPane)}`;
            bar.hidden = false;
            input.focus();
            input.select();
            update();
        }

        input.addEventListener("input", update);
        input.addEventListener("keydown", event => {
            if (event.key === "Enter") {
                event.preventDefault();
                positionAt(current + (event.shiftKey ? -1 : 1));
            } else if (event.key === "Escape") {
                event.preventDefault();
                close();
            }
        });
        document.getElementById("LP5-FindPrevious").addEventListener("click", () => positionAt(current - 1));
        document.getElementById("LP5-FindNext").addEventListener("click", () => positionAt(current + 1));
        document.getElementById("LP5-FindClose").addEventListener("click", close);
        document.addEventListener("LP5-PaneSelectionChanged", () => {
            if (!bar.hidden) update();
        });
        document.addEventListener("LP5-PaneViewSelectionChanged", () => {
            if (!bar.hidden) update();
        });
        window.addEventListener("keydown", event => {
            if ((event.ctrlKey || event.metaKey) && !event.altKey && event.key.toLowerCase() === "f") {
                event.preventDefault();
                open();
            }
        }, true);
    }

    // Select Source initially, then mark the pane the user is interacting with.
    function initializePaneSelection() {
        const panes = ["LP5-Toc", "LP5-Source", "LP5-Output"]
            .map(id => document.getElementById(id));
        function select(pane) {
            const changed = panes.some(candidate => candidate.classList.contains("LP5-PaneSelected") !== (candidate === pane));
            for (const candidate of panes)
                candidate.classList.toggle("LP5-PaneSelected", candidate === pane);
            if (changed)
                document.dispatchEvent(new Event("LP5-PaneSelectionChanged"));
        }
        select(document.getElementById("LP5-Source"));
        for (const pane of panes) {
            pane.addEventListener("pointerdown", () => select(pane));
            pane.addEventListener("focusin", () => select(pane));
        }
    }

    function initializePaneSplitters() {
        const main = document.getElementById("LP5-Main");
        const panes = [...main.children].filter(node => !node.classList.contains("LP5-PaneSplitter"));
        for (const splitter of main.querySelectorAll(".LP5-PaneSplitter")) {
            let drag;
            function finish(event) {
                if (!drag || event.pointerId !== drag.pointerId) return;
                drag = null;
                main.classList.remove("LP5-Resizing");
                if (splitter.hasPointerCapture(event.pointerId))
                    splitter.releasePointerCapture(event.pointerId);
            }
            splitter.addEventListener("pointerdown", event => {
                if (event.button !== 0 || !event.isPrimary || drag || main.classList.contains("LP5-Resizing")) return;
                const widths = panes.map(pane => pane.getBoundingClientRect().width);
                const available = widths.reduce((sum, width) => sum + width, 0);
                if (!available) return;
                panes.forEach((pane, index) => pane.style.flex = `${widths[index]} 1 0px`);
                const left = splitter.previousElementSibling;
                const right = splitter.nextElementSibling;
                const leftWidth = widths[panes.indexOf(left)];
                const total = leftWidth + widths[panes.indexOf(right)];
                drag = {pointerId: event.pointerId, x: event.clientX, left, right, leftWidth, total};
                splitter.setPointerCapture(event.pointerId);
                main.classList.add("LP5-Resizing");
                event.preventDefault();
            });
            splitter.addEventListener("pointermove", event => {
                if (!drag || event.pointerId !== drag.pointerId) return;
                const minimum = Math.min(100, drag.total / 2);
                const width = Math.max(minimum, Math.min(drag.total - minimum,
                    drag.leftWidth + event.clientX - drag.x));
                drag.left.style.flexGrow = width;
                drag.right.style.flexGrow = drag.total - width;
            });
            for (const name of ["pointerup", "pointercancel", "lostpointercapture"])
                splitter.addEventListener(name, finish);
        }
    }

    function startup() {
        initializePaneViews();
        initializePaneFind();
        initializePaneSelection();
        initializePaneSplitters();
        model.addEventListener("ProjectLoaded", renderProject);
        const reload = document.getElementById("LP5-Reload");
        reload.addEventListener("click", () => {
            reload.disabled = true;
            controller.dispatch({ name: "ReloadProject" });
        });
        const deleteDatabase = document.getElementById("LP5-DeleteDatabase");
        const status = document.getElementById("LP5-Status");
        deleteDatabase.addEventListener("click", async () => {
            if (!confirm("Delete the current LP5 IndexedDB database? This removes remembered local directories."))
                return;
            deleteDatabase.disabled = true;
            status.textContent = "Deleting LP5 database…";
            try {
                await util.indexedDB.deleteDatabase(() => {
                    status.textContent = "Waiting for other LP5 tabs to release the database…";
                });
                status.textContent = "LP5 database deleted. Reload the page to recreate it.";
            } catch (error) {
                status.textContent = `Database deletion failed: ${error.message}`;
            } finally {
                deleteDatabase.disabled = false;
            }
        });
    }

    return { startup, showModalDialog, showArticleEditor, showArticleEditorError, closeModalDialog };
})();
]]></code>
    </section>
</template>