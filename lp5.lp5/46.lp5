<template>
    <heading>Edit Article Dialog</heading>
    <keywords><li>article editor</li><li>dialog</li><li>save</li></keywords>
    <section data-lp5-kind="explanation"><p>The editor has separate Article and Code panes for title, explanation, keywords, code name, and code. References appear as <code>⟦LP5-REF: bundle name⟧</code> markers so they stay references when saved. Drag the divider or focus it and use the arrow keys to resize the panes. Save is enabled only after a change; child links remain unchanged.</p><p>Title and Explanation accept well-formed XML markup. Enter one keyword per line. A code section is created when either Code field contains text and removed when both fields are blank. Save serializes the fields into an article draft, then the model validates and stores it. Errors stay in the dialog with the draft intact.</p></section>
    <section data-lp5-kind="code"><name>EditArticle</name><code><![CDATA[
<template id="EditArticle">
<style>
#EditArticle-dialog{box-sizing:border-box;width:min(58rem,calc(100vw - 2rem));min-width:min(36rem,calc(100vw - 2rem));max-width:calc(100vw - 2rem);min-height:min(28rem,calc(100vh - 2rem));max-height:calc(100vh - 2rem);resize:both;overflow:hidden;padding:0;border:1px solid #b8bec7;border-radius:.5rem;box-shadow:0 1rem 3rem rgb(0 0 0 / 22%);color:#20242a;font:.9375rem/1.4 system-ui,sans-serif}
#EditArticle-dialog[open]{display:flex;flex-direction:column}#EditArticle-dialog::backdrop{background:rgb(18 24 32 / 48%)}
.edit-head{padding:.8rem 1rem;border-bottom:1px solid #d8dde4}.edit-title{display:flex;justify-content:space-between;align-items:baseline;gap:1rem}.edit-title h2{margin:0;font-size:1.2rem}#EditArticle-filename{color:#5c6673;font:.85rem ui-monospace,monospace}
.edit-content{flex:1;display:flex;min-height:0;overflow:auto;padding:.8rem 1rem}.edit-pane{flex:1 1 0;min-width:0;overflow:auto}.edit-pane:first-child{padding-right:.5rem}.edit-pane:last-child{padding-left:.5rem}.edit-pane h3{margin:0 0 .6rem;font-size:1rem}.field{margin:0 0 .7rem}.field label{display:block;margin-bottom:.2rem;font-weight:600}.field input,.field textarea{box-sizing:border-box;display:block;width:100%;padding:.4rem .5rem;border:1px solid #8b949e;border-radius:.25rem;background:white;color:inherit;font:inherit}.field textarea{resize:vertical}.field textarea:focus,.field input:focus{outline:2px solid #1769aa;outline-offset:1px}.field input[type=checkbox]{display:inline;width:auto;vertical-align:middle;margin-right:.4rem}.code{font:.9rem/1.45 ui-monospace,monospace!important;tab-size:4}.hint{margin:.2rem 0 0;color:#5c6673;font-size:.85rem}
.divider{flex:0 0 1.2rem;position:relative;cursor:col-resize;touch-action:none}.divider:before{content:"";position:absolute;inset:0 auto 0 50%;width:1px;background:#c4cbd4;transform:translateX(-50%)}.divider:hover:before,.divider:focus-visible:before{width:3px;background:#1769aa}.divider:focus-visible{outline:2px solid #1769aa;outline-offset:-2px}
#EditArticle-error{margin:0;padding:.2rem 1rem;color:#a00;white-space:pre-wrap}.edit-foot{display:flex;justify-content:flex-end;gap:.6rem;padding:.7rem 1rem;border-top:1px solid #d8dde4;background:#f7f8fa}.edit-foot button{padding:.5rem 1rem;border:1px solid #7d8793;border-radius:.3rem;background:white;font:600 .95rem system-ui;cursor:pointer}.edit-foot [data-id="save"]{border-color:#185a36;background:#216e42;color:white}.edit-foot button:disabled{opacity:.5;cursor:default}.edit-foot button:focus-visible{outline:2px solid #1769aa;outline-offset:2px}
@media(max-width:48rem){.edit-content{flex-direction:column}.divider{flex-basis:1.2rem;cursor:row-resize}.divider:before{inset:50% 0 auto;width:auto;height:1px;transform:translateY(-50%)}.edit-pane:first-child{padding:0 0 .5rem}.edit-pane:last-child{padding:.5rem 0 0}}
</style>
<dialog id="EditArticle-dialog" aria-labelledby="EditArticle-title"><header class="edit-head"><div class="edit-title"><h2 id="EditArticle-title">Edit Article</h2><span id="EditArticle-filename"></span></div></header>
<div class="edit-content" data-id="content"><section class="edit-pane" data-id="articlePane"><h3>Article</h3>
<div class="field"><label for="EditArticle-heading">Title</label><textarea id="EditArticle-heading" data-id="heading" rows="1" aria-describedby="heading-hint"></textarea><p class="hint" id="heading-hint">XML markup is allowed.</p></div>
<div class="field"><label for="EditArticle-explanation">Explanation</label><textarea id="EditArticle-explanation" data-id="explanation" rows="8"></textarea></div>
<div class="field"><label for="EditArticle-keywords">Keywords</label><textarea id="EditArticle-keywords" data-id="keywords" rows="3" aria-describedby="keywords-hint"></textarea><p class="hint" id="keywords-hint">Enter one keyword per line.</p></div></section>
<div class="divider" data-id="divider" role="separator" aria-label="Resize Article and Code sections" aria-orientation="vertical" aria-valuemin="20" aria-valuemax="80" aria-valuenow="50" tabindex="0"></div>
<section class="edit-pane" data-id="codePane"><h3>Code</h3><div class="field"><label for="EditArticle-code-name">Name</label><input id="EditArticle-code-name" data-id="codeName" type="text"><p class="hint">Blank means unnamed code.</p></div>
<div class="field"><label for="EditArticle-code">Code</label><textarea id="EditArticle-code" data-id="code" class="code" rows="15" spellcheck="false" aria-describedby="code-hint"></textarea><p class="hint" id="code-hint">References appear as ⟦LP5-REF: bundle name⟧ markers.</p></div></section></div>
<p id="EditArticle-error" role="alert" hidden></p><footer class="edit-foot"><button id="EditArticle-cancel" data-id="cancel" type="button">Cancel</button><button id="EditArticle-save" data-id="save" type="button" disabled>Save</button></footer>
<script>
const {filename,source}=ctx, n=elementByID;
for(const el of elementByID["EditArticle-dialog"].querySelectorAll("[data-id]"))n[el.dataset.id]=el;
const parse=s=>new DOMParser().parseFromString(s,"application/xml");
const bad=d=>[...d.getElementsByTagName("parsererror")].some(x=>x.namespaceURI==="http://www.mozilla.org/newlayout/xml/parsererror.xml"||x.namespaceURI==="http://www.w3.org/1999/xhtml");
const article=parse(source);if(bad(article))throw Error("Cannot open malformed article XML");const root=article.documentElement;
const direct=f=>[...root.children].find(f), heading=direct(x=>x.tagName==="heading"), explanation=direct(x=>x.tagName==="section"&&x.getAttribute("data-lp5-kind")==="explanation"), keywords=direct(x=>x.tagName==="keywords"), codeSection=direct(x=>x.tagName==="section"&&x.getAttribute("data-lp5-kind")==="code"), codeName=codeSection&&codeSection.querySelector("name"), code=codeSection&&codeSection.querySelector("code");
n["EditArticle-filename"].textContent=filename;n.heading.value=heading?.innerHTML||"";n.explanation.value=explanation?.innerHTML||"";n.keywords.value=[...(keywords?.children||[])].map(x=>x.textContent).join("\n");n.codeName.value=codeName?.textContent||"";
n.code.value=[...(code?.childNodes||[])].map(x=>x.nodeType===1&&x.tagName==="lp5-"?"⟦LP5-REF: "+x.getAttribute("ref")+"⟧":x.textContent).join("");
const fields=[n.heading,n.explanation,n.keywords,n.codeName,n.code], values=()=>fields.map(x=>x.value), initial=values();
const refresh=()=>{n.save.disabled=values().every((x,i)=>x===initial[i]);n["EditArticle-error"].hidden=true};fields.forEach(x=>x.addEventListener("input",refresh));refresh();
const fragment=s=>{const d=parse("<wrap>"+s+"</wrap>");if(bad(d))throw Error("Title and Explanation must contain well-formed XML markup");return d.documentElement};
const markup=(el,s)=>{const f=fragment(s);el.replaceChildren(...[...f.childNodes].map(x=>article.importNode(x,true)))};
const upsert=(tag,yes)=>{let x=direct(y=>y.tagName===tag);if(!yes){x?.remove();return null}if(!x){x=article.createElement(tag);root.append(x)}return x};
const cdata=(el,s)=>{while(s.includes("]]"+">")){const i=s.indexOf("]]"+">");el.append(article.createCDATASection(s.slice(0,i+2)));s=s.slice(i+2)}if(s)el.append(article.createCDATASection(s))};
const draft=()=>{const t=n.heading.value,h=upsert("heading",!!t.trim());if(h)markup(h,t);
let e=direct(x=>x.tagName==="section"&&x.getAttribute("data-lp5-kind")==="explanation");if(!e&&n.explanation.value.trim()){e=article.createElement("section");root.append(e)}if(e){e.setAttribute("data-lp5-kind","explanation");if(n.explanation.value.trim())markup(e,n.explanation.value);else e.remove()}
const terms=n.keywords.value.split(/\r?\n/).map(x=>x.trim()).filter(Boolean),k=upsert("keywords",terms.length>0);if(k){k.replaceChildren();for(const term of terms){const li=article.createElement("li");li.textContent=term;k.append(li)}}
let s=direct(x=>x.tagName==="section"&&x.getAttribute("data-lp5-kind")==="code");if(!n.codeName.value.trim()&&!n.code.value.trim()){s?.remove();return new XMLSerializer().serializeToString(article)}if(!s)s=article.createElement("section");s.setAttribute("data-lp5-kind","code");s.replaceChildren();const nm=article.createElement("name");nm.textContent=n.codeName.value;s.append(nm);const c=article.createElement("code"),text=n.code.value,pattern=/⟦LP5-REF: ([^⟧]+)⟧/g;let last=0,m;while((m=pattern.exec(text))){cdata(c,text.slice(last,m.index));const ref=article.createElement("lp5-");ref.setAttribute("ref",m[1].trim());c.append(ref);last=pattern.lastIndex}cdata(c,text.slice(last));s.append(c);if(!s.parentNode)root.append(s);return new XMLSerializer().serializeToString(article)};
n.save.addEventListener("click",()=>{if(n.save.disabled)return;try{const text=draft();n.save.disabled=n.cancel.disabled=true;window.LP5.controller.dispatch({name:"SaveArticle",filename,text})}catch(e){n["EditArticle-error"].textContent=e.message;n["EditArticle-error"].hidden=false}});
n.cancel.addEventListener("click",()=>window.LP5.controller.dispatch({name:"CancelEditArticle"}));
const dialog=n["EditArticle-dialog"],divider=n.divider,content=n.content;let ratio=.5,drag=null;const setSplit=r=>{ratio=Math.max(.2,Math.min(.8,r));n.articlePane.style.flex=ratio+" 1 0";n.codePane.style.flex=(1-ratio)+" 1 0";divider.setAttribute("aria-valuenow",String(Math.round(ratio*100)))};
divider.addEventListener("pointerdown",e=>{if(e.button!==0)return;drag={x:e.clientX,y:e.clientY,ratio};divider.setPointerCapture(e.pointerId);e.preventDefault()});divider.addEventListener("pointermove",e=>{if(!drag)return;const v=matchMedia("(max-width:48rem)").matches,extent=v?content.clientHeight:content.clientWidth;if(extent)setSplit(drag.ratio+((v?e.clientY-drag.y:e.clientX-drag.x)/extent))});for(const type of ["pointerup","pointercancel","lostpointercapture"])divider.addEventListener(type,()=>drag=null);
divider.addEventListener("keydown",e=>{const v=matchMedia("(max-width:48rem)").matches,keys=v?["ArrowUp","ArrowDown"]:["ArrowLeft","ArrowRight"];if(!keys.includes(e.key))return;e.preventDefault();setSplit(ratio+(e.key===keys[0]?-.02:.02))});
dialog.addEventListener("cancel",e=>{e.preventDefault();window.LP5.controller.dispatch({name:"CancelEditArticle"})});return dialog;
</script></dialog></template>
]]></code></section>
</template>
