    <section data-lp5-kind="code">
        <name>JavaScript units</name>
        <code><![CDATA[let model = (() => {
    const notifications = new EventTarget();
    let projectStorage = null;
    let selectionId = 0;
    let articles = new Map();
    let rootFilename = null;
    let bundles = new Map();
    let referrers = new Map();

    async function selectProject(project) {
        if (project !== projectStorage) selectionId++;
        projectStorage = project;
    }

    ]]><lp5- ref="Model article XML"/><lp5- ref="Model bundle indexes"/><lp5- ref="Model project loading"/><![CDATA[

    return {
        addEventListener: notifications.addEventListener.bind(notifications),
        removeEventListener: notifications.removeEventListener.bind(notifications),
        selectProject,
        loadProject,
        get rootFilename() { return rootFilename; },
        getArticle,
        docOrder,
        getBundle,
        getReferrers
    };
})();
]]></code>
    </section>
</template>
