    <section data-lp5-kind="code">
        <name>JavaScript units</name>
        <code><![CDATA[let model = (() => {
    let directoryHandle = null;
    let articles = new Map();
    let rootFilename = null;
    let bundles = new Map();
    let referrers = new Map();

    async function selectProject(handle) {
        await util.indexedDB.storeDirectoryHandle(handle);
        directoryHandle = handle;
    }

    ]]><lp5- ref="Model article XML"/><lp5- ref="Model bundle indexes"/><lp5- ref="Model project loading"/><![CDATA[

    return {
        selectProject,
        loadProject,
        get rootFilename() { return rootFilename; },
        getArticle,
        docOrder,
        getBundle,
        getReferrers
    };
})();
]]></code>
    </section>
</template>
