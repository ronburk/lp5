<template>
    <heading>Table of Contents</heading>
    <keywords><li>view</li><li>navigation</li><li>table of contents</li></keywords>
    <section data-lp5-kind="explanation">
        <p>The Source Pane and TOC describe the same model records. Filenames connect their elements because titles may be repeated; maps avoid turning filenames into CSS selectors. Model document order and parent filenames determine the nested lists. Untitled articles remain in the Source Pane but have no TOC entry; their titled descendants appear under the nearest titled ancestor.</p>
        <p>Collapse state belongs to View and survives reloads of the selected storage object. A new model selection ID clears it, including when two projects have identical filenames. Selecting an entry highlights its source article and scrolls only the Source Pane; an internal explanation link selects and scrolls its target there without changing the URL. Changing a disclosure control does not select an article. Clicking a Source Pane article selects it without scrolling; these paths share the same marker and TOC highlight. Selection resets on load, rather than following manual scrolling.</p>
    </section>
    <section data-lp5-kind="code">
        <name>View table of contents</name>
        <code><![CDATA[let displayedSelectionId;
const collapsedArticles = new Set();
const articleElementsByView = new Map();
const tocEntriesByView = new Map();
let selectedFilename = null;

function selectArticle(filename) {
    selectedFilename = filename;
    for (const entries of articleElementsByView.values())
        for (const [articleFilename, element] of entries)
            element.classList.toggle("LP5-Selected", articleFilename === filename);
    for (const entries of tocEntriesByView.values())
        for (const [articleFilename, element] of entries) {
            if (articleFilename === filename) element.setAttribute("aria-current", "true");
            else element.removeAttribute("aria-current");
        }
    highlightOutputArticle();
}

function scrollToArticle(filename, pane = activePaneView("LP5-Source")) {
    const article = pane && articleElementsByView.get(pane)?.get(filename);
    if (!article) return;
    pane.scrollTop += article.getBoundingClientRect().top -
        pane.getBoundingClientRect().top - pane.clientTop;
}

function renderTocPane(pane, articles) {
    const navigation = renderTableOfContents(articles, pane);
    pane.replaceChildren(navigation.content);
    pane.scrollTop = 0;
    pane.scrollLeft = 0;
    tocEntriesByView.set(pane, navigation.entries);
}

function updateTocExpansion(filename, title) {
    for (const pane of paneViews("LP5-Toc")) {
        const parent = [...pane.querySelectorAll("li[data-lp5-filename]")]
            .find(element => element.dataset.lp5Filename === filename);
        const nested = parent?.querySelector(":scope > ul");
        const toggle = parent?.querySelector(":scope > .LP5-TocRow > .LP5-TocToggle");
        if (!nested || !toggle) continue;
        const open = !collapsedArticles.has(filename);
        nested.hidden = !open;
        toggle.textContent = open ? "▾" : "▸";
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", (open ? "Collapse " : "Expand ") + title);
    }
}

function renderTableOfContents(articles, pane) {
    const children = new Map();
    for (const article of articles) {
        if (!children.has(article.parentFilename))
            children.set(article.parentFilename, []);
        children.get(article.parentFilename).push(article);
    }
    const entries = new Map();
    function list(parentFilename) {
        const ul = document.createElement("ul");
        for (const article of children.get(parentFilename) || []) {
            const heading = Array.from(article.document.documentElement.children)
                .find(element => element.tagName === "heading");
            const title = heading?.textContent.trim();
            const nested = list(article.filename);
            if (!title) {
                ul.append(...nested.children);
                continue;
            }
            const li = document.createElement("li");
            li.dataset.lp5Filename = article.filename;
            const row = document.createElement("div");
            row.className = "LP5-TocRow";
            const button = document.createElement("button");
            button.type = "button";
            button.textContent = title;
            button.title = article.filename;
            button.className = "LP5-TocEntry";
            button.addEventListener("click", () => {
                selectPaneView(pane);
                selectArticle(article.filename);
                scrollToArticle(article.filename);
            });
            entries.set(article.filename, button);
            li.append(row);
            if (nested.children.length) {
                const toggle = document.createElement("button");
                toggle.type = "button";
                toggle.className = "LP5-TocToggle";
                toggle.addEventListener("click", () => {
                    selectPaneView(pane);
                    if (collapsedArticles.has(article.filename))
                        collapsedArticles.delete(article.filename);
                    else
                        collapsedArticles.add(article.filename);
                    updateTocExpansion(article.filename, title);
                });
                const open = !collapsedArticles.has(article.filename);
                nested.hidden = !open;
                toggle.textContent = open ? "▾" : "▸";
                toggle.setAttribute("aria-expanded", String(open));
                toggle.setAttribute("aria-label", (open ? "Collapse " : "Expand ") + title);
                row.append(toggle, button);
                li.append(nested);
            } else {
                const spacer = document.createElement("span");
                spacer.className = "LP5-TocSpacer";
                spacer.setAttribute("aria-hidden", "true");
                row.append(spacer, button);
            }
            ul.append(li);
        }
        return ul;
    }
    return { content: list(null), entries };
}
]]></code>
    </section>
</template>
