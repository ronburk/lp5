<template>
    <heading>Dialog templates</heading>
    <keywords>
        <li>dialog</li>
        <li>template</li>
        <li>modal</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>
            Dialog markup lives in named child templates inside
            <code>LP5-Dialog-Templates</code>. The Select/Create dialog uses
            action names for the generic dialog operation to handle.
        </p>
    </section>
    <section data-lp5-kind="code">
        <name>Dialog templates</name>
        <code><![CDATA[
<template id="LP5-Dialog-Templates">
    <template id="LP5-SelectCreateProject">
        <style>
            .LP5-SelectCreateProject {
                max-width: 25rem;
                padding: 1.25rem;
                text-align: center;
            }

            .LP5-SelectCreateProject h2 {
                margin: 0 0 1rem;
                font-size: 1.25rem;
            }

            .LP5-SelectCreateProject .dialog-buttons {
                display: flex;
                justify-content: center;
                gap: 1rem;
            }

            .LP5-SelectCreateProject button {
                padding: 0.6rem 1.2rem;
                font-size: 1rem;
            }

            .LP5-SelectCreateProject [role="alert"] {
                color: #a00;
            }
        </style>
        <dialog class="LP5-SelectCreateProject"
                aria-labelledby="LP5-SelectCreateProject-title">
            <h2 id="LP5-SelectCreateProject-title">Select or Create a Project</h2>
            <div class="dialog-buttons">
                <button type="button" autofocus data-action="Select">Select</button>
                <button type="button" data-action="Create">Create</button>
            </div>
            <p data-name="selectionError" role="alert"></p>
        </dialog>
    </template>
</template>
]]></code>
    </section>
</template>
