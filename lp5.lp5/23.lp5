<template>
    <children>
        <li id="24.lp5"/>
    </children>
    <heading>Dialog templates</heading>
    <keywords>
        <li>dialog</li>
        <li>template</li>
        <li>modal</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>
            Dialog markup lives in named child templates inside
            <code>LP5-Dialog-Templates</code>. Each dialog has its own article, and
            its bundle name matches the dialog template ID. The parent template
            also contains styles shared by all modal dialogs.
        </p>
    </section>
    <section data-lp5-kind="code">
        <name>Dialog templates</name>
        <code><![CDATA[
<template id="LP5-Dialog-Templates">
    <style>
        dialog:modal {
            max-width: 25rem;
            padding: 1.25rem;
        }

        dialog:modal button {
            padding: 0.6rem 1.2rem;
            font-size: 1rem;
        }

        dialog:modal [role="alert"] {
            color: #a00;
        }
    </style>
    ]]><lp5- ref="LP5-Dialog-SelectCreateProject"/><![CDATA[
</template>
]]></code>
    </section>
</template>
