<template>
    <heading>Persistent directory handles</heading>
    <keywords>
        <li>IndexedDB</li>
        <li>directory handle</li>
        <li>persistence</li>
        <li>optimistic concurrency</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>IndexedDB is used only for local filesystem <a href="https://developer.mozilla.org/en-US/docs/Web/API/FileSystemDirectoryHandle">directory handles</a>. Each directory is stored under a unique string ID; its display name is not treated as a unique identity. <code>loadHandles()</code> returns an object keyed by ID, <code>addHandle(directoryHandle)</code> returns the existing or newly created named handle, and <code>deleteHandle(namedHandle)</code> is safe to repeat. <code>deleteDatabase()</code> removes the current LP5 database for development reset.</p>
        <p>The object store contains one pool record, <code>{revision, handles}</code>. Every mutation reads that record, performs asynchronous <a href="https://developer.mozilla.org/en-US/docs/Web/API/FileSystemHandle/isSameEntry"><code>isSameEntry()</code></a> comparisons outside a transaction, then checks the revision and writes the replacement pool in one readwrite transaction. If another tab committed first, the operation retries against the newer pool. The transaction check and write are atomic because <a href="https://developer.mozilla.org/en-US/docs/Web/API/IDBTransaction">IndexedDB readwrite transactions</a> serialize on this store. Callbacks can run more than once after a conflict and must not perform unrelated side effects.</p>
        <p>All database connections close after each operation and close immediately when another tab requests a version change. The utility does not cache handles, request permissions, or perform UI work. Legacy per-handle records are not migrated; use the developer menu's database reset when changing this development schema.</p>
    </section>
    <section data-lp5-kind="code">
        <name>Directory handle persistence</name>
        <code><![CDATA[const indexedDB = (() => {
    const databaseName = "LP5";
    const databaseVersion = 2;
    const storeName = "directoryHandles";
    const poolKey = "pool";

    async function withDatabase(operation) {
        const database = await new Promise((resolve, reject) => {
            const request = window.indexedDB.open(databaseName, databaseVersion);
            request.onupgradeneeded = () => {
                if (!request.result.objectStoreNames.contains(storeName))
                    request.result.createObjectStore(storeName);
            };
            request.onsuccess = () => {
                request.result.onversionchange = () => request.result.close();
                resolve(request.result);
            };
            request.onerror = () => reject(request.error);
        });

        try {
            return await operation(database);
        } finally {
            database.close();
        }
    }

    function readPool(database) {
        return new Promise((resolve, reject) => {
            const transaction = database.transaction(storeName, "readonly");
            const request = transaction.objectStore(storeName).get(poolKey);
            let pool;
            request.onsuccess = () => { pool = request.result; };
            transaction.oncomplete = () => resolve(pool || { revision: 0, handles: {} });
            transaction.onabort = () => reject(
                transaction.error || new Error("Directory handle read aborted")
            );
        });
    }

    function writePoolIfCurrent(database, revision, handles) {
        return new Promise((resolve, reject) => {
            const transaction = database.transaction(storeName, "readwrite");
            const store = transaction.objectStore(storeName);
            const request = store.get(poolKey);
            let committed = false;
            request.onsuccess = () => {
                const currentRevision = request.result?.revision ?? 0;
                if (currentRevision !== revision) return;
                store.put({ revision: revision + 1, handles }, poolKey);
                committed = true;
            };
            transaction.oncomplete = () => resolve(committed);
            transaction.onabort = () => reject(
                transaction.error || new Error("Directory handle write aborted")
            );
        });
    }

    async function updatePool(change) {
        for (;;) {
            const { revision, handles } = await withDatabase(readPool);
            const update = await change(handles);
            if (!update.write) return update.result;
            const committed = await withDatabase(database =>
                writePoolIfCurrent(database, revision, update.handles)
            );
            if (committed) return update.result;
        }
    }

    function loadHandles() {
        return withDatabase(async database => (await readPool(database)).handles);
    }

    async function addHandle(directoryHandle) {
        const id = crypto.randomUUID();
        const namedHandle = { id, directoryHandle };
        return updatePool(async handles => {
            for (const existing of Object.values(handles)) {
                if (await existing.directoryHandle.isSameEntry(directoryHandle))
                    return { write: false, result: existing };
            }
            return {
                write: true,
                handles: { ...handles, [id]: namedHandle },
                result: namedHandle
            };
        });
    }

    function deleteHandle(namedHandle) {
        return updatePool(handles => {
            if (!Object.hasOwn(handles, namedHandle.id))
                return { write: false, result: undefined };
            const updated = { ...handles };
            delete updated[namedHandle.id];
            return { write: true, handles: updated, result: undefined };
        });
    }

    function deleteDatabase(onBlocked = () => {}) {
        return new Promise((resolve, reject) => {
            const request = window.indexedDB.deleteDatabase(databaseName);
            request.onsuccess = () => resolve();
            request.onerror = () => reject(request.error);
            request.onblocked = onBlocked;
        });
    }

    return { loadHandles, addHandle, deleteHandle, deleteDatabase };
})();
]]></code>
    </section>
</template>
