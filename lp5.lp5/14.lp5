<template>
    <heading>Global page layout</heading>
    <keywords>
        <li>CSS</li>
        <li>layout</li>
        <li>toolbar</li>
        <li>navigation</li>
        <li>panes</li>
        <li>status bar</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>
            Long articles and expanded code must scroll within their panes
            while commands and status remain visible. Flex children need explicit
            <a href="https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/min-width">minimum sizes of zero</a> so their content cannot force the whole page
            beyond the viewport; <a href="https://developer.mozilla.org/en-US/docs/Web/CSS/Guides/Display/Flow_layout_and_overflow">overflow</a> belongs to each pane instead.
        </p>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 560 214" role="img" aria-labelledby="pageLayoutTitle pageLayoutDescription" style="display:block; width:min(100%, 560px); height:auto; margin:0.75rem auto; font:12px sans-serif">
            <title id="pageLayoutTitle">LP5 page layout</title>
            <desc id="pageLayoutDescription">A top navigation bar, three middle panes separated by draggable splitters, and a bottom status bar.</desc>
            <rect x="8" y="8" width="544" height="198" rx="5" fill="#fff" stroke="#526174" stroke-width="2"/>
            <g>
                <title>#LP5-TopNav: the top-level header containing the command toolbar.</title>
                <rect x="18" y="18" width="524" height="28" rx="3" fill="#dce8f5" stroke="#7890aa"/>
                <text x="280" y="36" text-anchor="middle" fill="#17283a">#LP5-TopNav</text>
            </g>

            <g>
                <title>#LP5-Main: the flexible middle row. It contains the Table of Contents, Source, and Output panes, with splitters between them.</title>
                <rect x="14" y="52" width="532" height="114" rx="3" fill="none" stroke="#526174" stroke-width="1.5" stroke-dasharray="4 2"/>
                <text x="24" y="68" fill="#526174">#LP5-Main</text>
                <g>
                    <title>#LP5-Toc: the Table of Contents pane. It starts at one quarter of the middle row's width and scrolls independently.</title>
                    <rect x="18" y="72" width="116" height="84" rx="3" fill="#edf2f7" stroke="#7890aa"/>
                    <text x="76" y="119" text-anchor="middle" fill="#17283a">#LP5-Toc</text>
                </g>

                <g>
                    <title>.LP5-PaneSplitter: a narrow draggable divider that changes the widths of the panes on either side.</title>
                    <rect x="138" y="72" width="8" height="84" fill="#8293a6"/>
                    <path d="M142 100v16 M139 104l3-4 3 4 M139 112l3 4 3-4" fill="none" stroke="#fff" stroke-width="1.5"/>
                </g>

                <g>
                    <title>#LP5-Source: the pane that displays the selected articles' explanations and code definitions. It scrolls independently.</title>
                    <rect x="150" y="72" width="184" height="84" rx="3" fill="#f7f4e8" stroke="#b5a36e"/>
                    <text x="242" y="119" text-anchor="middle" fill="#342d1c">#LP5-Source</text>
                </g>

                <g>
                    <title>.LP5-PaneSplitter: a narrow draggable divider that changes the widths of the panes on either side.</title>
                    <rect x="338" y="72" width="8" height="84" fill="#8293a6"/>
                    <path d="M342 100v16 M339 104l3-4 3 4 M339 112l3 4 3-4" fill="none" stroke="#fff" stroke-width="1.5"/>
                </g>

                <g>
                    <title>#LP5-Output: the pane that shows generated code. It shares the remaining middle-row width and scrolls independently.</title>
                    <rect x="350" y="72" width="192" height="84" rx="3" fill="#e8f2eb" stroke="#7d9c84"/>
                    <text x="446" y="119" text-anchor="middle" fill="#203b29">#LP5-Output</text>
                </g>
            </g>

            <g>
                <title>#LP5-Status: a short status bar along the bottom edge of the page. It does not grow with the middle row.</title>
                <rect x="18" y="176" width="524" height="20" rx="2" fill="#dce8f5" stroke="#7890aa"/>
                <text x="280" y="190" text-anchor="middle" fill="#17283a">#LP5-Status</text>
            </g>
        </svg>
    </section>
    <section data-lp5-kind="code">
        <name>Global CSS declarations</name>
        <code><![CDATA[
* {
    box-sizing: border-box;
}

html,
body {
    height: 100%;
    margin: 0;
}

body {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

#LP5-TopNav {
    flex: 0 0 auto;
    padding: 0.25rem 0.5rem;
    background: #dce8f5;
    border-bottom: 1px solid #7890aa;
}

#LP5-TopNav [role="toolbar"] {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

#LP5-Main {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
}

#LP5-Toc,
#LP5-Source,
#LP5-Output {
    border-top: 2px solid transparent;
    min-width: 0;
    min-height: 0;
    overflow: auto;
}

#LP5-Toc {
    flex: 0 0 25%;
}

#LP5-Source,
#LP5-Output {
    flex: 1 1 0;
}

#LP5-Toc.LP5-PaneSelected,
#LP5-Source.LP5-PaneSelected,
#LP5-Output.LP5-PaneSelected {
    border-top-color: #155f63;
}

.LP5-PaneSplitter {
    position: relative;
    flex: 0 0 4px;
    cursor: col-resize;
    touch-action: none;
}

#LP5-Main.LP5-Resizing,
#LP5-Main.LP5-Resizing * {
    cursor: col-resize;
    user-select: none;
}

.LP5-PaneSplitter::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 1px;
    width: 2px;
    background: #8293a6;
}

.LP5-PaneSplitter:hover::after {
    left: 0;
    width: 4px;
    background: #526174;
}

#LP5-Status {
    display: flex;
    align-items: center;
    flex: 0 0 1.5rem;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    background: #dce8f5;
    border-top: 1px solid #7890aa;
}

#LP5-Source > .LP5-Article {
    margin: 0.5rem;
    border: 1px solid #c8c3af;
}

.LP5-Article > h2 {
    margin: 0;
    padding: 0.35rem 0.5rem;
    font-size: 1.1rem;
    background: #f7f4e8;
}

.LP5-Article > h2 > small {
    font-size: 0.75rem;
    font-weight: normal;
    color: #526174;
}

.LP5-Article > .LP5-Explanation {
    padding: 0.5rem;
    background: #f7f4e8;
    overflow-wrap: anywhere;
}

.LP5-Explanation a.LP5-InternalLink {
    color: #155f63;
    text-decoration-style: dotted;
    text-underline-offset: 0.12em;
}

.LP5-Explanation a.LP5-ExternalLink {
    color: #704080;
    text-underline-offset: 0.12em;
}

.LP5-Explanation a.LP5-ExternalLink::after {
    content: " ↗";
    font-size: 0.8em;
    text-decoration: none;
}

.LP5-Article > .LP5-CodeName {
    padding: 0.25rem 0.5rem;
    font-size: 0.85rem;
    background: #edf2f7;
    overflow-wrap: anywhere;
}

.LP5-Article > pre {
    margin: 0;
    padding: 0.5rem;
    background: white;
    white-space: pre;
    overflow-wrap: normal;
    overflow-x: auto;
    overflow-y: hidden;
}

#LP5-Toc ul {
    list-style: none;
    padding-left: 1rem;
    margin: 0;
}

#LP5-Toc > ul {
    padding: 0.5rem 0.25rem;
}

.LP5-TocRow {
    display: flex;
    align-items: baseline;
}

.LP5-TocToggle,
.LP5-TocEntry {
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    padding: 0.2rem;
    cursor: pointer;
}

.LP5-TocToggle,
.LP5-TocSpacer {
    flex: 0 0 1.25rem;
}

.LP5-TocEntry {
    text-align: left;
    overflow-wrap: anywhere;
    min-width: 0;
}

.LP5-TocEntry:hover,
.LP5-TocEntry[aria-current="true"] {
    background: #dce8f5;
}

#LP5-Source > .LP5-Article {
    border-left: 3px solid transparent;
}

#LP5-Source > .LP5-Article.LP5-Selected {
    border-left-color: #17283a;
}

#LP5-SourceContextMenu {
    position: fixed;
    z-index: 10;
    padding: 0.25rem;
    border: 1px solid #7890aa;
    background: white;
    box-shadow: 0 2px 6px #0004;
}

#LP5-SourceContextMenu[hidden] { display: none; }

#LP5-SourceContextMenu button {
    display: block;
    width: 100%;
    border: 0;
    padding: 0.35rem 0.75rem;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
}

#LP5-SourceContextMenu button:hover,
#LP5-SourceContextMenu button:focus-visible {
    background: #dce8f5;
}

.LP5-CodeReference {
    background: #f7f4e8;
    cursor: pointer;
}

.LP5-CodeReference::before { content: "〈"; }
.LP5-CodeReference::after { content: "〉"; }

.LP5-OutputChoice {
    display: block;
    padding: 0.35rem 0.5rem;
    background: #edf2f7;
}

.LP5-ExpandedCode {
    margin: 0;
    padding: 0.5rem;
    white-space: pre;
    min-width: max-content;
}

.LP5-OutputArticle { cursor: pointer; }
.LP5-OutputArticle.LP5-OutputFolded {
    display: inline-block;
    padding: 0 0.25rem;
    border: 1px solid #8a6d1d;
    border-radius: 3px;
    background: #fff4c2;
    color: #493900;
}
.LP5-OutputFolded > :not(.LP5-OutputFoldPlaceholder) { display: none; }
.LP5-OutputFoldPlaceholder { font-style: italic; }
.LP5-OutputArticle.LP5-OutputSelected > .LP5-OutputText,
.LP5-ReferenceTarget .LP5-OutputArticle > .LP5-OutputText { background: #d9eaff; }
.LP5-OutputMissing { background: #ffe5e5; color: #8b1111; }
]]></code>
    </section>
</template>
