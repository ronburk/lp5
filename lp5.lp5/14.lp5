<template>
    <heading>We style epigraphs to have a horizontal rule.</heading>
    <name>Global CSS declarations</name>
    <script type="text/plain">
     div.epigraph  {
         display: flex;
         justify-content: flex-end;
         flex-flow: wrap;
     }
     div.epigraph > div {
         max-width: 27em;
     }
     div.epigraph  hr { width:100%; display:none;}
    </script>
</template>
