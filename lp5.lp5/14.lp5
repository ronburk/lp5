<template>
    <heading>We style epigraphs to have a horizontal rule.</heading>
    <lp5-code>
        <name>Global CSS declarations</name>
        <code><![CDATA[
     div.epigraph  {
         display: flex;
         justify-content: flex-end;
         flex-flow: wrap;
     }
     div.epigraph > div {
         max-width: 27em;
     }
     div.epigraph  hr { width:100%; display:none;}
    ]]></code>
    </lp5-code>
</template>
