<template>
    <heading>Global page layout</heading>
    <keywords>
        <li>CSS</li>
        <li>layout</li>
        <li>navigation</li>
        <li>panes</li>
        <li>status bar</li>
    </keywords>
    <section data-lp5-kind="explanation">
        <p>
            The page is a column: the navigation bar is at the top, the
            three working panes fill the middle, and the status bar is at
            the bottom. The middle row may shrink below the viewport's
            height because each pane owns its own scrolling.
        </p>
    </section>
    <section data-lp5-kind="code">
        <name>Global CSS declarations</name>
        <code><![CDATA[
* {
    box-sizing: border-box;
}

html,
body {
    height: 100%;
    margin: 0;
}

body {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

#LP5-TopNav {
    flex: 0 0 auto;
}

#LP5-Main {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
}

#LP5-Toc,
#LP5-Source,
#LP5-Output {
    min-width: 0;
    min-height: 0;
    overflow: auto;
}

#LP5-Toc {
    flex: 0 0 25%;
}

#LP5-Source,
#LP5-Output {
    flex: 1 1 0;
}

.LP5-PaneSplitter {
    flex: 0 0 4px;
    cursor: col-resize;
}

#LP5-Status {
    flex: 0 0 1.5rem;
    min-height: 1.5rem;
    overflow: hidden;
}
]]></code>
    </section>
</template>
