<template>
    <heading>lp5: The Program</heading>
    <section data-lp5-kind="explanation">
        <div>
            <p>
                lp5 is written in <q>vanilla</q> <a href="https://developer.mozilla.org/en-US/docs/Web/HTML">HTML</a>.
                It is self-contained, so you can copy it
                (<code>lp5.html</code>)
                to your local filesystem and run it on a
                machine that isn't connected to the internet.
            </p>
        </div>
    </section>
    <section data-lp5-kind="code">
        <name/>
        <code><![CDATA[
            <!doctype html>
            <html lang="en">
                <head>
                </head>
                <body>
                </body>
            </html>
        ]]></code>
    </section>
</template>
