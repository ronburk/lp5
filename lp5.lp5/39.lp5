<template>
    <heading>Displaying articles</heading>
    <keywords><li>view</li><li>rendering</li><li>articles</li></keywords>
    <section data-lp5-kind="explanation">
        <p>The Source Pane is a presentation of model XML, not an editing copy of it. Explanation markup is parsed as HTML through <a href="https://developer.mozilla.org/en-US/docs/Web/API/Element/innerHTML"><code>Element.innerHTML</code></a> so paragraphs and SVG illustrations retain their browser presentation. Literal code and LP references are displayed as text, preventing source code from becoming live page elements. An article without a nonblank heading has no generated heading.</p>
        <p>A <a href="#32.lp5">model load</a> replaces the entire article display in document order. Building the replacement offscreen keeps the old display intact until the new one is ready, and rendering never moves nodes out of the model. The view subscribes during startup, before the first project can be selected. The <a href="#40.lp5">TOC</a> is built from the same records and installed alongside the source, so both panes change together. <a href="#42.lp5">Output</a> is rebuilt from the same records after Source and TOC are installed. Reference buttons preserve literal source text while providing navigation into expansions. In an explanation, link to another loaded article with its filename as a fragment, for example <code>&lt;a href="#30.lp5"&gt;...&lt;/a&gt;</code>. The view intercepts that link to select and scroll the target article without changing the browser URL.</p>
    </section>
    <section data-lp5-kind="code">
        <name>View article rendering</name>
        <code><![CDATA[function renderArticle(article) {
    const source = article.document.documentElement;
    const sections = Array.from(source.children);
    const heading = sections.find(element => element.tagName === "heading");
    const explanation = sections.find(element =>
        element.tagName === "section" && element.getAttribute("data-lp5-kind") === "explanation");
    const codeSection = sections.find(element =>
        element.tagName === "section" && element.getAttribute("data-lp5-kind") === "code");
    const rendered = document.createElement("article");
    rendered.className = "LP5-Article";
    rendered.dataset.lp5Filename = article.filename;
    rendered.addEventListener("click", () => selectArticle(article.filename));

    const titleText = heading?.textContent.trim();
    if (titleText) {
        const title = document.createElement("h2");
        title.textContent = titleText;
        const filename = document.createElement("small");
        filename.textContent = article.filename;
        title.append(" ", filename);
        rendered.append(title);
    }

    if (explanation) {
        const content = document.createElement("div");
        content.className = "LP5-Explanation";
        content.innerHTML = explanation.innerHTML;
        rendered.append(content);
    }
    if (codeSection) {
        const name = codeSection.querySelector("name");
        const label = document.createElement("div");
        label.className = "LP5-CodeName";
        label.textContent = name.textContent.trim() || "Unnamed code";
        const pre = document.createElement("pre");
        const text = document.createElement("code");
        for (const part of codeParts(article).parts) {
            if (part.kind === "reference") {
                const reference = document.createElement("span");
                reference.className = "LP5-CodeReference";
                reference.dataset.ref = part.name;
                reference.textContent = part.name;
                reference.addEventListener("click", event => {
                    event.preventDefault();
                    event.stopPropagation();
                    showCodeReference(article.filename, part.sourceOffset, part.name);
                });
                text.append(reference);
            } else if (part.showSource) text.append(document.createTextNode(part.text));
        }
        pre.append(text);
        rendered.append(label, pre);
    }
    return rendered;
}

function renderProject(event) {
    const pane = document.getElementById("LP5-Source");
    const toc = document.getElementById("LP5-Toc");
    if (!pane || !toc) throw new Error("Missing LP5-Source or LP5-Toc pane");
    const selectionId = event.detail.selectionId;
    const newSelection = selectionId !== displayedSelectionId;
    if (newSelection) collapsedArticles.clear();
    const articles = [...model.docOrder()];
    const content = document.createDocumentFragment();
    const elements = new Map();
    for (const article of articles) {
        const element = renderArticle(article);
        elements.set(article.filename, element);
        content.append(element);
    }
    const navigation = renderTableOfContents(articles);
    pane.replaceChildren(content);
    toc.replaceChildren(navigation.content);
    articleElements = elements;
    tocEntries = navigation.entries;
    selectedFilename = null;
    displayedSelectionId = selectionId;
    document.getElementById("LP5-Reload").disabled = false;
    pane.scrollTop = 0;
    initializeOutput(articles, newSelection);
    initializeSourceContextMenu(pane);
    initializeExplanationLinks(pane);
}

function initializeExplanationLinks(pane) {
    if (pane.dataset.explanationLinksReady) return;
    pane.dataset.explanationLinksReady = "true";

    for (const link of pane.querySelectorAll(".LP5-Explanation a[href]")) {
        const href = link.getAttribute("href");
        if (href.startsWith("#") && articleElements.has(href.slice(1))) {
            link.classList.add("LP5-InternalLink");
            continue;
        }
        let url;
        try {
            url = new URL(href, document.baseURI);
        } catch {
            continue;
        }
        if (url.protocol !== "http:" && url.protocol !== "https:") continue;
        link.classList.add("LP5-ExternalLink");
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.setAttribute("aria-label", `${link.textContent.trim() || "External link"} (opens in a new tab)`);
    }

    pane.addEventListener("click", event => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest(".LP5-Explanation a.LP5-InternalLink");
        if (!link) return;
        const filename = link.getAttribute("href").slice(1);
        event.preventDefault();
        event.stopPropagation();
        selectArticle(filename);
        scrollToArticle(filename);
    }, true);
}

function initializeSourceContextMenu(pane) {
    const menu = document.getElementById("LP5-SourceContextMenu");
    const item = menu?.querySelector('[role="menuitem"]');
    if (!menu || !item || pane.dataset.contextMenuReady) return;
    pane.dataset.contextMenuReady = "true";

    pane.addEventListener("contextmenu", event => {
        const article = event.target.closest(".LP5-Article");
        if (!article || !pane.contains(article)) return;
        event.preventDefault();
        menu.dataset.lp5Filename = article.dataset.lp5Filename;
        menu.hidden = false;
        menu.style.left = `${Math.max(0, Math.min(event.clientX, innerWidth - menu.offsetWidth))}px`;
        menu.style.top = `${Math.max(0, Math.min(event.clientY, innerHeight - menu.offsetHeight))}px`;
        item.focus();
    });

    item.addEventListener("click", () => { menu.hidden = true; });
    document.addEventListener("click", event => {
        if (!menu.hidden && !menu.contains(event.target)) menu.hidden = true;
    });
}
]]></code>
    </section>
</template>
